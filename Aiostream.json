  "formatter": {
    "id": "gdrive",
    "definitions": {
      "custom": {
        "name": "{stream.resolution::exists[\"{stream.resolution::replace('2160p','4K ')::replace('1440p','QHD ')::replace('1080p','FHD ')::replace('720p','HD ')::replace('576p','LQ ')::replace('480p','LQ ')::replace('360p','LQ ')::replace('240p','LQ ')::replace('144p','LQ ')}\"||\"❗️ Unknown \"]}{service.cached::istrue[\"⚡ Ready \"||\"⏳ Not Ready \"]}\n{stream.nSeScore::exists[\"{stream.nSeScore::pstar::string::replace('⯪','½')}\"||\"\"]}\n",
        "description": "{stream.title::exists[\"🎬 {stream.title} \"||\"\"]}{stream.year::exists[\"({stream.year}) \"||\"\"]}{stream.editions::exists[\"✂️ {stream.editions::join(', ')} \"||\"\"]}{stream.seasonEpisode::exists[\"📅 {stream.seasonEpisode::join(' ')} \"||\"\"]}\n{addon.name::exists[\"☁️ {addon.name} \"||\"\"]}{service.name::exists[\"🔗 {service.name}\"||\"\"]} {stream.indexer::exists[\"📡 {stream.indexer}\"||\"\"]}\n{stream.languages::exists[\"💬 {stream.languages::join(' / ')} \"||\"\"]} {stream.size::exists[\"💾 {stream.size::bytes} \"||\"\"]}\n"
      }
    }
